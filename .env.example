# Answerable environment. Copy to .env (gitignored) and fill in.
# Secrets live outside the repo tree in deployment; never commit real values.

# LLM interpretation (infer station); falls back to the claude CLI when unset.
ANTHROPIC_API_KEY=

# Outbound notification webhook: `tick` posts its review summary here when set.
ANSWERABLE_NOTIFY_WEBHOOK=

# X (Twitter) mentions lane.
X_BEARER_TOKEN=

# Performance lane (Google PageSpeed Insights).
PAGESPEED_API_KEY=

# DataForSEO SERP lane.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Google Search Console lane (OAuth credentials + property), and analytics via
# a Google service-account JSON file path.
GSC_OAUTH_CLIENT_ID=
GSC_OAUTH_CLIENT_SECRET=
GSC_OAUTH_REFRESH_TOKEN=
GSC_SITE_URL=
GOOGLE_APPLICATION_CREDENTIALS=

# Bing Webmaster Tools lane.
BING_WEBMASTER_KEY=

# Google Analytics 4 property for the analytics lane.
GA4_PROPERTY_ID=

# Optional: name the person the approve verb records (falls back to $USER, then
# "operator"). Set it on a shared box or in CI.
# ANSWERABLE_APPROVER=

# Optional: sqlite database path override (defaults to data/answerable.db).
# ANSWERABLE_DB_PATH=

# Optional: managed credential file the CLI sources at startup
# (defaults to ~/.config/answerable/env).
# ANSWERABLE_ENV_PATH=
